# The Pizza Dough Formula - Environment Variables
# Copy this file to .env and fill in your values

# PostHog project token (public: it is included in the browser bundle).
# Without it, analytics does not load. See docs/analytics-events.md.
PUBLIC_POSTHOG_KEY=

# n8n Email Capture Webhook
PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/pizza-dough-leads

# Site URL (for canonical links and sharing)
PUBLIC_SITE_URL=https://thepizzadoughformula.com
