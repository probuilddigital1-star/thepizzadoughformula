---
/**
 * Individual Pizza Style Pages
 * Dynamic route for each pizza style with detailed content and schema markup
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import PizzaStyleIcon from '../../components/icons/PizzaStyleIcon.astro';
import ContentSections from '../../components/content/ContentSections.astro';
import { PIZZA_STYLES } from '../../scripts/calculator/presets.js';
import { DoughCalculator } from '../../scripts/calculator/engine.js';
import { datesForPath, formatDate } from '../../../scripts/page-dates.mjs';

export function getStaticPaths() {
  return [
    { params: { style: 'neapolitan' } },
    { params: { style: 'new-york' } },
    { params: { style: 'detroit' } },
    { params: { style: 'thin-crispy' } },
    { params: { style: 'poolish-biga' } },
    { params: { style: 'emergency' } },
  ];
}

/**
 * A block inside a content section. `note` is a labeled paragraph, used for the schedule days and
 * the ingredient roles, where each paragraph opens with a short lead-in.
 */
type Block =
  | { kind: 'p'; text: string }
  | { kind: 'note'; term: string; text: string }
  | { kind: 'table'; columns: string[]; rows: string[][] };

type Section = { title: string; blocks: Block[] };

/** A step in the on-page instructions. A plain string gets a generated name (see stepName). */
type Step = string | { name: string; text: string };

// Content for each style page - SEO-optimized long-form content
const styleContent: Record<string, {
  slug: string;
  metaTitle: string;
  metaDescription: string;
  intro: string;
  history: string;
  historyTitle: string;
  // Optional: a style whose sections cover the same ground in more detail omits these
  doughScience?: string;
  doughScienceTitle?: string;
  // Sections between the intro and the history
  leadSections?: Section[];
  // Sections between the dough science and the instructions
  sections?: Section[];
  technique: Step[];
  techniqueTitle: string;
  commonMistakes: string[];
  // Works cited on the page, shown as a Sources list at the end of the article
  sources?: { label: string; url: string }[];
  // Low end of every fermentation range this page states, in minutes. Used for the Recipe totalTime,
  // so the schema is never shorter than the schedule in the visible instructions.
  minimumFermentationMinutes: number;
  relatedStyles: string[];
}> = {
  neapolitan: {
    slug: 'neapolitan',
    metaTitle: 'Neapolitan Pizza Dough Recipe & Calculator',
    metaDescription: 'Master authentic Neapolitan pizza dough with 60-65% hydration, 00 flour, and 24-72 hour cold fermentation. Free calculator with baker\'s percentages.',
    intro: 'Neapolitan pizza is the original — born in Naples, Italy, and protected by the Associazione Verace Pizza Napoletana (AVPN). It\'s defined by a soft, pillowy cornicione (rim), charred leopard spots from intense heat, and a thin, slightly wet center. The dough is deceptively simple: flour, water, salt, and yeast. No oil, no sugar. The magic is in the technique and fermentation.',
    historyTitle: 'The Origins of Neapolitan Pizza',
    history: 'Neapolitan pizza traces back to 18th century Naples, where flatbreads topped with tomatoes became street food for the working class. The iconic Margherita pizza was reportedly created in 1889 by Raffaele Esposito to honor Queen Margherita of Italy, using tomato (red), mozzarella (white), and basil (green) to represent the Italian flag. In 2017, UNESCO recognized the art of Neapolitan pizza-making as an Intangible Cultural Heritage of Humanity.',
    doughScienceTitle: 'Understanding the Dough',
    doughScience: 'Neapolitan dough uses 00 flour (finely milled Italian flour with 11-12.5% protein) at 60-65% hydration. The lower hydration compared to other styles makes the dough easier to hand-stretch into the classic round shape. Cold fermentation for 24-72 hours develops complex flavors — lactic and acetic acids create subtle tang while enzymes break down starches for better browning. The minimal yeast (0.1-0.3%) means slow, controlled fermentation that builds character without overwhelming yeast flavor.',
    techniqueTitle: 'How to Make Neapolitan Pizza Dough',
    technique: [
      'Dissolve salt in cold water (55-60°F / 13-16°C), then add to 00 flour. Mix until a shaggy dough forms.',
      'Knead for 15-20 minutes by hand until smooth and elastic. The dough should pass the windowpane test — stretch a small piece thin enough to see light through without tearing.',
      'Bulk ferment at room temperature for 1-2 hours, covered with a damp cloth.',
      'Divide into 250g balls (for 12" pizzas). Shape each ball by tucking edges underneath to create surface tension.',
      'Cold ferment in individual containers for 24-72 hours. Longer fermentation = more flavor complexity.',
      'Remove from fridge 2 hours before baking. Let dough reach room temperature for easier stretching.',
      'Stretch by hand only — never use a rolling pin. Push gas from center to edges, then use gravity to stretch. The cornicione should remain puffy with trapped gas.',
      'Bake at 450-500°C (850-900°F) for 60-90 seconds. The extreme heat creates leopard spotting on the crust.'
    ],
    commonMistakes: [
      'Using a rolling pin — this destroys the air bubbles that create the signature puffy cornicione.',
      'Under-fermenting — rushing with more yeast sacrifices flavor. Plan ahead and give it 24+ hours.',
      'Baking too cool — below 400°C you\'ll dry out the dough before it chars. Use a pizza oven or broiler method.',
      'Over-topping — Neapolitan pizza is minimalist. Too many toppings make the thin center soggy.',
      'Not preheating enough — your pizza stone or steel needs at least 45 minutes at max temperature.'
    ],
    // Minimums from the stated ranges: 1 h bulk + 24 h cold ferment + 2 h out of the fridge + 2 h proof
    minimumFermentationMinutes: 60 + 24 * 60 + 120 + 120,
    relatedStyles: ['newYork', 'poolishBiga']
  },
  newYork: {
    slug: 'new-york',
    metaTitle: 'New York Pizza Dough Recipe and Calculator: Foldable Slices at Home',
    metaDescription: 'A New York style pizza dough recipe with gram amounts, a cold-ferment schedule, and a calculator that scales it to any number of pies. High-gluten flour, a little oil and sugar, 24 to 72 hours in the fridge.',
    intro: 'New York pizza is the wide, thin slice you can fold in half. The crust is crisp on the bottom, chewy in the rim, and pliable enough to bend without cracking. Three things make the dough behave that way. High-protein flour builds enough gluten to hold a big thin slice. A little oil and sugar help the crust brown and stay tender at home-oven temperatures, which are far below a pizzeria deck. And a day or more in the fridge develops flavor and makes the dough easy to stretch. The calculator on this page scales the recipe to however many pies you want.',
    leadSections: [
      {
        title: 'The recipe in grams',
        blocks: [
          { kind: 'p', text: 'Four 14-inch pizzas, 280 g dough balls, 65% hydration. These are the calculator’s default numbers for this style.' },
          {
            kind: 'table',
            columns: ['Ingredient', 'Amount', "Baker's %"],
            rows: [
              ['High-gluten bread flour', '650 g', '100%'],
              ['Water, cold', '422 g', '65%'],
              ['Fine sea salt', '13 g', '2%'],
              ['Instant yeast', '2.6 g', '0.4%'],
              ['Olive oil', '19 g', '3%'],
              ['Sugar', '13 g', '2%']
            ]
          },
          { kind: 'p', text: 'Total dough 1120 g. For different sizes, the calculator uses about 220 g for a 10-inch pie, 280 g for 14 inches and 450 g for 18 inches. Change the count or size and every line updates.' }
        ]
      }
    ],
    historyTitle: 'How New York Pizza Became Iconic',
    history: 'Italian immigrants brought pizza to New York in the early 1900s. Gennaro Lombardi opened the first documented American pizzeria in 1905 on Spring Street in Manhattan. New York water — with its unique mineral content — is often credited for the distinctive crust, though this is debated. What\'s not debated: the style evolved to be larger, crispier, and more substantial than its Neapolitan ancestor, designed for New York\'s grab-and-go food culture.',
    sections: [
      {
        title: 'What each ingredient is doing',
        blocks: [
          { kind: 'note', term: 'Flour.', text: 'High-gluten bread flour at 13 to 14% protein is the traditional choice, and it is what gives the slice its chew and lets it stay flat when you pick it up. King Arthur’s Sir Lancelot and General Mills All Trumps are the pizzeria standards at about 14% protein. Ordinary bread flour at 12 to 13% works well and is what most home recipes call for; the crust will be a little less chewy. Italian 00 flour is the wrong tool here. It is milled for very hot ovens and short bakes, and at 500°F it stays pale and soft.' },
          { kind: 'note', term: 'Water, at 65%.', text: 'This is on the moist side for a New York dough, which makes a more open crumb and an easier stretch. If you find the dough hard to handle, drop to 60 to 62% in the calculator; the slice will be a little denser and crisper.' },
          { kind: 'note', term: 'Oil, at 3%.', text: 'Oil coats the gluten strands, which tenderizes the crumb and keeps a thin crust from turning into a cracker. It also helps the bottom brown on a home oven’s stone or steel.' },
          { kind: 'note', term: 'Sugar, at 2%.', text: 'Sugar feeds browning. Pizzeria ovens run at 550°F and above and brown a crust in minutes; a home oven at 500°F needs the help. It does not make the crust taste sweet at this level.' },
          { kind: 'note', term: 'Salt, at 2%.', text: 'Flavor, and it tightens the gluten slightly.' },
          { kind: 'note', term: 'Yeast, at 0.4%.', text: 'Enough for a slow rise in the fridge without over-proofing over two or three days. If you use active dry instead of instant, switch the yeast type in the calculator; it adjusts the amount.' }
        ]
      },
      {
        title: 'Cold fermentation: why and how long',
        blocks: [
          { kind: 'p', text: 'Once the dough is balled it goes into the fridge, where the yeast slows down and enzymes keep working on the flour. That does two things you can taste and feel. The flavor deepens, and the gluten relaxes so the dough stretches wide without springing back. Twenty-four hours is the minimum to get the benefit. Forty-eight to seventy-two hours is where most people settle. Past three days the dough starts to lose strength and the balls slacken.' },
          { kind: 'p', text: 'Put each ball in its own lidded container or on an oiled tray under plastic wrap, so they do not grow into each other. Take them out one to two hours before you bake; cold dough tears and shrinks back when stretched.' }
        ]
      },
      {
        title: 'A schedule',
        blocks: [
          { kind: 'p', text: 'This is an estimate for a kitchen around 68 to 72°F and a normal fridge. Times shift with temperature, so treat the readiness signs as the real guide.' },
          { kind: 'note', term: 'Day 1, evening.', text: 'Mix the dough with cold water. Knead 10 to 15 minutes by hand until smooth and only slightly tacky. Rest it, covered, 1 to 2 hours at room temperature until it looks a little puffed, not doubled. Divide into 280 g balls, shape each into a tight round, and put them in the fridge in separate containers.' },
          { kind: 'note', term: 'Day 2 or 3.', text: 'Take the balls out one to two hours before baking. Put the steel or stone in the oven and run it at 500 to 550°F for at least 45 minutes to an hour; a steel needs the full hour to hold enough heat. Stretch each ball from the center out, leaving a slightly thicker rim, to about 14 inches. Top lightly. Bake 8 to 12 minutes until the rim is golden and spotted and the bottom is crisp.' },
          { kind: 'p', text: 'If day 2 turns into day 4, the dough will still work; expect a slacker ball that needs gentler handling and a more pronounced flavor.' }
        ]
      }
    ],
    techniqueTitle: 'How to Make New York Pizza Dough',
    technique: [
      { name: 'Mix', text: 'Combine the flour, cold water, salt, sugar, oil and yeast until no dry flour remains.' },
      { name: 'Knead', text: '10 to 15 minutes by hand until smooth and elastic. Slightly tacky is right; sticky means it needs another minute.' },
      { name: 'Rest', text: '1 to 2 hours at room temperature, covered, until slightly puffed.' },
      { name: 'Divide and ball', text: 'Portion into 280 g balls for 14-inch pizzas. Shape each into a tight round.' },
      { name: 'Cold ferment', text: 'Refrigerate the balls in separate containers for 24 to 72 hours.' },
      { name: 'Warm up', text: 'Take the balls out 1 to 2 hours before baking.' },
      { name: 'Preheat', text: 'Steel or stone at 500 to 550°F for at least 45 minutes to an hour.' },
      { name: 'Stretch and bake', text: 'Stretch to 14 inches with a slight rim, top lightly, bake 8 to 12 minutes until golden and spotted.' }
    ],
    commonMistakes: [
      'Using 00 flour. It is made for ovens twice as hot as yours and will not brown at 500°F. Use bread flour or high-gluten flour.',
      'Leaving out the oil and sugar. They are what make browning possible at home temperatures. This is the difference between a golden crust and a pale one.',
      'A short preheat. A stone or steel that has only had 20 minutes is still cold in the middle. Give it 45 minutes to an hour.',
      'Stretching cold dough. Straight from the fridge it shrinks back and tears. Let the balls sit out 1 to 2 hours.',
      'Too much sauce or cheese. A thin slice cannot carry a heavy load; the center goes soggy and the fold collapses.'
    ],
    sources: [
      { label: 'King Arthur Baking, New York-Style Pizza recipe (bread flour, oil and sugar in the dough, 300 g balls for 13-inch pies, refrigerate up to 3 days, rest at least an hour after the fridge, 500°F preheat for at least an hour)', url: 'https://www.kingarthurbaking.com/recipes/new-york-style-pizza-recipe' },
      { label: 'King Arthur Sir Lancelot high-gluten flour, 14% protein (product listing)', url: 'https://www.kingarthurbaking.com/pro/products' },
      { label: 'USDA FoodData Central, for the calorie figures', url: 'https://fdc.nal.usda.gov/' }
    ],
    // Minimums from the stated ranges: 1 h rest + 24 h cold ferment + 1 h out of the fridge. The
    // 45 minute preheat runs while the balls warm up, so it is not added on top.
    minimumFermentationMinutes: 60 + 24 * 60 + 60,
    relatedStyles: ['neapolitan', 'thinCrispy']
  },
  detroit: {
    slug: 'detroit',
    metaTitle: 'Detroit Style Pizza Dough Recipe & Calculator',
    metaDescription: 'Make authentic Detroit-style pizza with 72% hydration, crispy frico cheese edges, and airy pan-baked crust. Free calculator with baker\'s percentages.',
    intro: 'Detroit-style pizza is a thick, rectangular pan pizza with an airy, focaccia-like crumb and the legendary frico — crispy caramelized cheese edges formed where shredded cheese meets the oiled pan walls. The dough is high-hydration, pressed into a well-oiled steel pan, and topped with cheese all the way to the edges. Sauce goes on top, in distinctive racing stripes.',
    historyTitle: 'Detroit Pizza: From Auto Parts to Pizza Pans',
    history: 'Detroit pizza was born at Buddy\'s Rendezvous in 1946 when Gus Guerra adapted his wife\'s Sicilian family recipe. The iconic blue steel pans were originally industrial parts trays from Detroit\'s auto factories. The square shape, thick crust, and cheese-to-the-edge style became a Detroit institution. The style remained a local secret until the 2010s when it exploded nationally, with chains like Emmy Squared and Via 313 bringing it to new markets.',
    doughScienceTitle: 'High-Hydration Pan Dough',
    doughScience: 'Detroit dough runs 70-75% hydration — significantly wetter than Neapolitan or NY styles. This high water content creates large, irregular air pockets in the crumb, similar to focaccia. The steel pan conducts heat intensely, crisping the bottom and edges while the interior stays light and airy. Bread flour (11-13% protein) provides enough structure to hold the open crumb without being too chewy. Oil in the pan and dough creates the signature crispy exterior.',
    techniqueTitle: 'How to Make Detroit Pizza Dough',
    technique: [
      'Mix bread flour, room temperature water (75-80°F), salt, yeast, oil, and sugar until combined.',
      'Use the stretch-and-fold technique: every 30 minutes for the first 2 hours, stretch one side of the dough up and fold it over itself. Rotate and repeat. This builds gluten without heavy kneading.',
      'Let the dough rise at room temperature for 3-4 hours total, until doubled in size.',
      'Generously oil a Detroit-style steel pan (blue steel or Lloyd\'s pan).',
      'Transfer dough to the pan. Press toward the edges. Let rest 30 minutes, then press again to fill corners.',
      'Top with Wisconsin brick cheese (or a mix of cheddar and mozzarella) all the way to the pan edges — this creates the frico.',
      'Add toppings, then ladle sauce in two or three racing stripes on top.',
      'Bake at 230-260°C (450-500°F) for 12-15 minutes until the cheese edges are deeply caramelized and crispy.'
    ],
    commonMistakes: [
      'Not enough oil in the pan — you need a generous amount for the crispy bottom and frico edges.',
      'Under-proofing — the dough needs to fully fill the pan. If it springs back, let it rest longer.',
      'Using mozzarella only — traditional Detroit uses brick cheese, which melts into a crispy layer. Mix cheddar and mozz as a substitute.',
      'Putting sauce under the cheese — Detroit style has sauce on top in racing stripes.',
      'Wrong pan — flimsy aluminum won\'t work. You need a heavy steel pan for proper heat transfer and frico.'
    ],
    // Minimums from the stated ranges: 3 h room temperature rise + 30 min rest in the pan
    minimumFermentationMinutes: 180 + 30,
    relatedStyles: ['newYork', 'emergency']
  },
  thinCrispy: {
    slug: 'thin-crispy',
    metaTitle: 'Thin & Crispy Pizza Dough Recipe & Calculator',
    metaDescription: 'Make tavern-style thin and crispy pizza dough with 55% hydration and cracker-like crust. Free calculator for party-cut square slices.',
    intro: 'Thin and crispy pizza — also called tavern-style or bar pizza — is a Midwest and Northeast staple. The crust is rolled thin, almost cracker-like, with a satisfying snap when you bite through. It\'s traditionally cut into squares (party cut) rather than triangles, making it perfect for sharing. Low hydration and a rolling pin are the keys to this style.',
    historyTitle: 'Tavern-Style: The People\'s Pizza',
    history: 'Tavern-style pizza emerged in Chicago\'s neighborhood bars in the mid-20th century as an alternative to deep-dish. It was designed to be eaten with one hand while the other held a beer. The square cut created smaller, snackable pieces perfect for sharing at the bar. Cities like St. Louis developed their own variations (Provel cheese, ultra-thin). This style outsells deep-dish in Chicago itself — it\'s the true everyday pizza of the Midwest.',
    doughScienceTitle: 'Low Hydration for Maximum Crunch',
    doughScience: 'At 55% hydration, thin and crispy dough is the driest pizza dough you\'ll make. This low water content makes the dough easy to roll very thin without it springing back or sticking. The result is a dense, cracker-like crust that crisps up beautifully. All-purpose flour (10-12% protein) is preferred over bread flour — less gluten development means a more tender, snappy bite rather than chewy. Docking (poking holes with a fork) prevents steam bubbles from forming during baking.',
    techniqueTitle: 'How to Make Thin & Crispy Pizza Dough',
    technique: [
      'Mix all-purpose flour with cool water (65-70°F), salt, yeast, and a small amount of oil.',
      'Knead briefly — just 5-8 minutes until smooth. You don\'t want extensive gluten development.',
      'Let rest at room temperature for 1-2 hours. Alternatively, cold ferment overnight for more flavor.',
      'Divide into 180g balls for 12" pizzas.',
      'Roll out with a rolling pin on a floured surface until very thin — about 2-3mm. Rotate the dough frequently.',
      'Dock the entire surface with a fork to prevent large bubbles during baking.',
      'Transfer to a pizza screen, sheet pan, or preheated steel.',
      'Top lightly (thin crust can\'t support heavy toppings) and bake at 230-260°C (450-500°F) for 8-10 minutes.',
      'Cut into squares (party cut), not triangles.'
    ],
    commonMistakes: [
      'Using bread flour — too much protein creates a chewy crust instead of crispy-snappy.',
      'Too much hydration — above 58% and you can\'t roll it thin enough.',
      'Forgetting to dock — undocked thin dough will puff up with huge bubbles in the oven.',
      'Overloading toppings — thin crust can\'t support heavy toppings. Keep it light.',
      'Cutting into triangles — tavern-style is always party cut (squares).'
    ],
    // Minimum from the stated range: 1 h rest. The overnight cold ferment the page mentions is optional.
    minimumFermentationMinutes: 60,
    relatedStyles: ['neapolitan', 'emergency']
  },
  poolishBiga: {
    slug: 'poolish-biga',
    metaTitle: 'Poolish vs Biga for Pizza: Which to Use, Plus a Calculator',
    metaDescription: 'Poolish or biga for pizza dough? A plain comparison, a worked recipe with gram amounts, a two-day schedule, and a calculator that does the pre-ferment math for you.',
    intro: "A pre-ferment is a small batch of flour, water and a little yeast that you mix the day before and let ferment on its own. The next day it goes into the final dough. That overnight head start gives the crust more flavor and better browning than a dough mixed all at once, and it makes the dough easier to stretch. Poolish and biga are the two common kinds. Poolish is wet, equal weights of flour and water. Biga is stiff, roughly half as much water as flour. The calculator on this page handles the split for you, so the water and yeast in the pre-ferment always count toward the totals.",
    leadSections: [
      {
        title: 'Poolish or biga: which should you use?',
        blocks: [
          { kind: 'p', text: 'Short answer. If this is your first pre-ferment, use poolish. It is easier to mix, easier to judge, and it fits a normal room-temperature kitchen and a 12 to 16 hour overnight window. Choose biga if you want a chewier crust with bigger, more irregular holes, if you are working at high hydration (70% and up), or if you want a pre-ferment that stays usable for longer once it is ready.' },
          {
            kind: 'table',
            columns: ['', 'Poolish', 'Biga'],
            rows: [
              ['Hydration of the pre-ferment', '100% (equal flour and water)', 'Stiff, about 45 to 60%. The calculator uses 55%'],
              ['Texture when ready', 'A loose, bubbly batter with a domed top', 'A shaggy, firm dough that has roughly doubled'],
              ['Flavor', 'Milder and slightly tangy, closer to yogurt', 'Sharper and more pronounced, closer to vinegar'],
              ['Crumb', 'Softer, with smaller and more even holes', 'Chewier, with larger and fewer holes'],
              ['Mixing it in', 'Easy, it dissolves into the final dough', 'Takes more work, tear it into pieces first'],
              ['Usable window once ready', 'Shorter, use it when it peaks', 'Longer, more forgiving if you are late'],
              ['Typical fermentation', '6 to 16 hours at room temperature', '12 to 24 hours, often somewhere cool (60 to 64°F)'],
              ['Suits', 'Hand kneading, Neapolitan and New York styles at 60 to 68% hydration', 'High hydration doughs, pan pizza, anyone who wants more chew']
            ]
          },
          { kind: 'p', text: 'The differences in the finished pizza are real but not dramatic. Most people would notice the chew and the hole structure before they noticed the flavor. If you make both from the same recipe you will have a better sense of which you prefer than any table can give you.' }
        ]
      }
    ],
    historyTitle: 'The Art of Pre-Fermentation',
    history: 'Pre-ferments have been used in bread baking for centuries. Poolish (named for Polish bakers who popularized it in France) became a staple of French bread-making. Biga is the Italian counterpart, used in ciabatta and many traditional Italian breads. Both techniques were adopted by artisan pizza makers seeking more flavor complexity than straight dough methods could provide. Today, many award-winning pizzerias use some form of pre-ferment.',
    doughScienceTitle: 'How Pre-Ferments Improve Dough',
    doughScience: 'During the 12-16 hour pre-ferment, yeast produces CO2, alcohol, and organic acids that contribute to flavor. Enzymes (amylase, protease) break down starches and proteins, improving dough extensibility and browning. The acids also strengthen the gluten network. By pre-fermenting 20 to 30% of the total flour, you get these benefits without over-fermenting the final dough. Poolish\'s high hydration promotes more enzymatic activity, while biga\'s lower hydration concentrates flavors differently.',
    sections: [
      {
        title: 'How much of the flour to pre-ferment',
        blocks: [
          { kind: 'p', text: 'The calculator lets you pre-ferment 15 to 50% of the total flour. Around 20 to 30% is the usual range for pizza and is the default here (25%). More pre-fermented flour means more flavor and a chewier, more open crumb, but the effect levels off around half the flour, and a dough with a very large pre-ferment is harder to time because so much of it is already fermented when you mix it. Start at 25% and move up once you have a feel for it.' }
        ]
      },
      {
        title: 'A worked example',
        blocks: [
          { kind: 'p', text: 'Four 12-inch pizzas, 260 g dough balls, 65% hydration, 2.5% salt, 0.2% instant yeast, 25% of the flour in the pre-ferment. These are the numbers the calculator produces for the default settings on this page.' },
          { kind: 'p', text: 'Totals for the whole recipe: 620 g flour, 403 g water, 16 g salt, 1.2 g instant yeast.' },
          { kind: 'p', text: 'With a poolish:' },
          {
            kind: 'table',
            columns: ['Stage', 'Flour', 'Water', 'Salt', 'Instant yeast'],
            rows: [
              ['Poolish (day 1)', '155 g', '155 g', 'none', '0.2 g'],
              ['Final dough (day 2)', '465 g', '248 g', '16 g', '1.1 g']
            ]
          },
          { kind: 'p', text: 'With a biga at 55% hydration:' },
          {
            kind: 'table',
            columns: ['Stage', 'Flour', 'Water', 'Salt', 'Instant yeast'],
            rows: [
              ['Biga (day 1)', '155 g', '85 g', 'none', '0.2 g'],
              ['Final dough (day 2)', '465 g', '318 g', '16 g', '1.1 g']
            ]
          },
          { kind: 'p', text: 'Note the water. The biga holds back 70 g of water that then goes into the final dough instead. That is the whole difference between the two on paper. The pre-ferment’s flour and water are part of the recipe, not extra, which is the mistake most people make when they first try one.' },
          { kind: 'p', text: 'Change the number of pizzas, ball size or hydration in the calculator and it recalculates both stages. Amounts under 10 g are shown to a tenth of a gram, so you will want a scale that reads to 0.1 g for the yeast.' }
        ]
      },
      {
        title: 'Yeast in the pre-ferment',
        blocks: [
          { kind: 'p', text: 'The pre-ferment needs very little yeast, because it has all night to work. The usual guidance for instant dry yeast, as a percentage of the flour in the pre-ferment, in a kitchen around 68 to 72°F:' },
          {
            kind: 'table',
            columns: ['Pre-ferment ready in', 'Instant yeast'],
            rows: [
              ['About 8 hours', '0.2 to 0.3%'],
              ['About 12 hours', '0.1 to 0.2%'],
              ['About 16 hours', '0.03 to 0.1%']
            ]
          },
          { kind: 'p', text: 'The calculator uses 0.1% of the pre-ferment flour, which suits the 12 to 16 hour overnight window most people use. The rest of the recipe’s yeast goes into the final dough. In a warm kitchen, use the low end of each range. If you use active dry yeast, switch the yeast type in the calculator and it adjusts the amounts.' }
        ]
      },
      {
        title: 'A two-day schedule',
        blocks: [
          { kind: 'p', text: 'This is an estimate for a kitchen at 68 to 72°F. Warmer rooms run faster, cooler rooms slower, and the readiness signs matter more than the clock.' },
          { kind: 'note', term: 'Day 1, evening (around 8 pm).', text: 'Mix the pre-ferment. Stir the flour, water and yeast together until there is no dry flour, cover the container, and leave it on the counter.' },
          { kind: 'note', term: 'Day 2, morning (8 to 10 am).', text: 'Check the pre-ferment. A poolish is ready when it has roughly doubled, the top is domed and covered in small bubbles, and it smells mildly tangy. A biga is ready when it has doubled and smells yeasty and pleasant. If a poolish has sunk in the middle and left a high-tide mark on the container, or either one smells sharply of alcohol, it has gone too far. It will still make dough, but the flavor will be harsher and the dough weaker.' },
          { kind: 'note', term: 'Day 2, late morning.', text: 'Mix the final dough. Combine the pre-ferment with the remaining flour, water, salt and yeast. Knead 10 to 15 minutes by hand until smooth. Pre-fermented dough is noticeably more extensible than a straight dough, so it will feel softer than you expect.' },
          { kind: 'note', term: 'Day 2, midday.', text: 'Bulk ferment 2 to 3 hours at room temperature until roughly doubled.' },
          { kind: 'note', term: 'Day 2, early afternoon.', text: 'Divide into 260 g balls and shape them with a tight surface. Proof the balls, covered, for 2 to 4 hours at room temperature.' },
          { kind: 'note', term: 'Day 2, evening (5 to 7 pm).', text: 'Stretch and bake at 500 to 575°F for 5 to 8 minutes. Pre-fermented doughs brown faster because the long ferment frees up more sugars, so watch the first pizza.' },
          { kind: 'p', text: 'If you want to bake the following day instead, put the balls in the fridge after shaping and take them out 1 to 2 hours before you bake. Up to 24 hours in the fridge is fine for a pre-fermented dough. Beyond that it starts to lose strength.' }
        ]
      }
    ],
    techniqueTitle: 'How to Make Pre-Fermented Pizza Dough',
    technique: [
      { name: 'Mix the pre-ferment', text: 'Day 1: stir the pre-ferment flour, water and yeast together until no dry flour remains. Cover.' },
      { name: 'Ferment overnight', text: 'Leave at room temperature 12 to 16 hours. Poolish should be bubbly and domed; biga should have doubled.' },
      { name: 'Mix the final dough', text: 'Day 2: combine the pre-ferment with the remaining flour, water, salt and yeast. Tear a biga into pieces first so it mixes in evenly.' },
      { name: 'Knead', text: '10 to 15 minutes by hand until smooth and elastic.' },
      { name: 'Bulk ferment', text: '2 to 3 hours at room temperature until roughly doubled.' },
      { name: 'Divide and ball', text: 'Portion into 260 g balls for 12-inch pizzas and shape with surface tension.' },
      { name: 'Proof', text: '2 to 4 hours at room temperature, covered, or refrigerate up to 24 hours and warm up 1 to 2 hours before baking.' },
      { name: 'Bake', text: '500 to 575°F for 5 to 8 minutes. Pre-fermented dough browns faster, so check early.' }
    ],
    commonMistakes: [
      'Forgetting that the pre-ferment’s flour and water are part of the recipe. They are not extra. The calculator subtracts them from the totals for you; if you are working from a recipe elsewhere, do the same.',
      'Too much yeast in the pre-ferment. 0.1% of the pre-ferment flour is enough for an overnight ferment. More than that and it peaks at 3 am and collapses by breakfast.',
      'Using the pre-ferment too late. A collapsed poolish or a biga that smells of alcohol has spent its strength. It still makes dough, but a weaker, sourer one.',
      'Using it too early. If it is not bubbly and risen, most of the benefit has not happened yet. Give it another hour or two.',
      'Rushing the second day. The pre-ferment does not shorten the final dough’s timeline. It still needs a bulk ferment and a proof after balling.'
    ],
    sources: [
      { label: 'Pizzablab, Poolish preferment guide (hydration, 0.1% instant yeast for an 8 to 16 hour ferment at about 68°F, readiness and over-fermentation signs)', url: 'https://www.pizzablab.com/the-encyclopizza/poolish-preferment/' },
      { label: 'Pizzablab, Poolish vs biga (flavor, crumb, handling and usability window, biga at 12 to 24 hours at 60 to 64°F)', url: 'https://www.pizzablab.com/learning-and-resources/general-articles/biga-vs-poolish/' },
      { label: 'Weekend Bakery, Poolish and biga tips (yeast by fermentation time, pre-fermented flour share leveling off around 50%)', url: 'https://www.weekendbakery.com/posts/more-artisan-bread-baking-tips-poolish-biga/' },
      { label: 'USDA FoodData Central, for the calorie figures', url: 'https://fdc.nal.usda.gov/' }
    ],
    // Minimums from the stated ranges: 12 h pre-ferment + 2 h bulk + 2 h proof
    minimumFermentationMinutes: 12 * 60 + 120 + 120,
    relatedStyles: ['neapolitan', 'newYork']
  },
  emergency: {
    slug: 'emergency',
    metaTitle: 'Quick Pizza Dough Recipe - Ready in 2 Hours',
    metaDescription: 'Same-day pizza dough ready in 2 hours. Quick emergency recipe with warm water and higher yeast for when you need pizza tonight. Free calculator.',
    intro: 'Sometimes you need pizza tonight and don\'t have 24 hours for cold fermentation. Emergency dough uses warm water and higher yeast to produce a workable dough in about 2 hours. It won\'t have the complex flavor of a long-fermented dough, but it\'s genuinely good pizza — and infinitely better than delivery.',
    historyTitle: 'The Case for Quick Dough',
    history: 'Quick doughs have always existed alongside long-fermented ones. Home cooks have been making same-day pizza dough for decades using various shortcuts. While artisan pizza culture emphasizes multi-day fermentation, the reality is that most pizza consumed worldwide is made with same-day dough. A well-made quick dough with proper hydration and technique still produces excellent results.',
    doughScienceTitle: 'Fast Fermentation Science',
    doughScience: 'Emergency dough uses 3-4x more yeast than cold-ferment recipes and warm water (100-110°F / 38-43°C) to accelerate fermentation. At these temperatures, yeast doubles its activity every 10°F. The tradeoff: faster rise means less time for enzymes to develop complex flavors and less acid production. Adding a small amount of sugar feeds the yeast and improves browning. Oil tenderizes the crumb, compensating for the shorter gluten development time.',
    techniqueTitle: 'How to Make Emergency Pizza Dough',
    technique: [
      'Use warm water (100-110°F / 38-43°C) — test with your finger; it should feel like a warm bath.',
      'Dissolve yeast and sugar in the warm water. Wait 5 minutes for it to foam (proof the yeast).',
      'Add flour, salt, and oil. Mix until combined, then knead for 8-10 minutes until smooth.',
      'Cover with a damp towel or plastic wrap. Place in a warm spot (near a warm oven or in a microwave with a cup of hot water).',
      'Let rise for 2 hours until doubled in size.',
      'Divide into balls (250g for 12" pizzas). Let rest 15 minutes for easier stretching.',
      'Shape and top immediately — don\'t let the dough over-proof.',
      'Bake at 230-260°C (450-500°F) for 8-12 minutes on a preheated pizza steel or stone.'
    ],
    commonMistakes: [
      'Water too hot — above 120°F kills yeast. Use 100-110°F.',
      'Not enough rise time — even "emergency" dough needs at least 2 hours. Skipping this makes dense, tough pizza.',
      'Using cold water with the same yeast amount — cold water slows yeast dramatically. If using cold water, you need to wait much longer.',
      'Overworking the dough — 8-10 minutes of kneading is sufficient. Over-kneading makes it tough.',
      'Forgetting the rest after balling — even 15 minutes makes a huge difference in stretchability.'
    ],
    // The page states a single rise, not a range: 2 h at room temperature
    minimumFermentationMinutes: 120,
    relatedStyles: ['thinCrispy', 'detroit']
  }
};

const { style: styleSlug } = Astro.params;
const content = Object.values(styleContent).find(s => s.slug === styleSlug);

if (!content) {
  return Astro.redirect('/pizza-styles');
}

// Map slug to preset ID
const slugToId: Record<string, string> = {
  'neapolitan': 'neapolitan',
  'new-york': 'newYork',
  'detroit': 'detroit',
  'thin-crispy': 'thinCrispy',
  'poolish-biga': 'poolishBiga',
  'emergency': 'emergency',
};

const presetId = slugToId[styleSlug!] || 'neapolitan';
const preset = PIZZA_STYLES[presetId];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Pizza Styles', href: '/pizza-styles' },
  { label: `${preset.name} Pizza` }
];

// Dates come from this file's git history (see scripts/page-dates.mjs)
const pageDates = datesForPath(Astro.url.pathname);
const lastUpdated = formatDate(pageDates?.modified);

// Quantities for the style's default recipe: 4 dough balls at the style's default ball weight
const defaultRecipe = new DoughCalculator({ ...preset.defaults, numBalls: 4 }).calculate();
const gramsText = (grams: number) => (grams < 10 ? `${Math.round(grams * 10) / 10} g` : `${Math.round(grams)} g`);
// "00 flour" from "00 Flour (Caputo Pizzeria, Antimo Caputo)"
const flourName = preset.flourRecommendation.replace(/\s*\([^)]*\)\s*$/, '').toLowerCase();
const recipeIngredients = defaultRecipe.valid
  ? [
      `${gramsText(defaultRecipe.ingredients.flour)} ${flourName}`,
      `${gramsText(defaultRecipe.ingredients.water)} water`,
      `${gramsText(defaultRecipe.ingredients.salt)} fine sea salt`,
      `${gramsText(defaultRecipe.ingredients.yeast)} instant yeast`,
      ...(defaultRecipe.ingredients.oil > 0 ? [`${gramsText(defaultRecipe.ingredients.oil)} olive oil`] : []),
      ...(defaultRecipe.ingredients.sugar > 0 ? [`${gramsText(defaultRecipe.ingredients.sugar)} sugar`] : [])
    ]
  : [];

/**
 * Calories per 100 g, from USDA FoodData Central. Only the flour, oil and sugar in a dough ball carry
 * any: water, salt and yeast add nothing meaningful at these weights. https://fdc.nal.usda.gov/
 */
const CALORIES_PER_100G = { flour: 361, oil: 884, sugar: 387 };

/** Per dough ball, rounded to the nearest 10 because it is an estimate, not a measurement. */
const caloriesPerBall = defaultRecipe.valid
  ? Math.round(
      ((defaultRecipe.ingredients.flour * CALORIES_PER_100G.flour +
        defaultRecipe.ingredients.oil * CALORIES_PER_100G.oil +
        defaultRecipe.ingredients.sugar * CALORIES_PER_100G.sugar) /
        100 /
        4) / 10
    ) * 10
  : 0;

/** Words too weak to end a generated step name. */
const TRAILING_STOP_WORDS = [
  'for', 'by', 'with', 'until', 'and', 'or', 'to', 'at', 'in', 'on', 'from',
  'then', 'before', 'after', 'a', 'the', 'of'
];

/** A short name for a step written as a plain sentence: its first few words, up to the first break. */
function stepName(text: string): string {
  const words = text.split(/[—–.:,(]/)[0].trim().split(/\s+/).slice(0, 6);
  while (words.length > 2 && TRAILING_STOP_WORDS.includes(words[words.length - 1].toLowerCase())) words.pop();
  return words.join(' ');
}

/**
 * Every step as { name, text, anchor }, so the page and the recipe markup use the same names.
 * A step written with its own name shows it as a lead-in; a generated name would only repeat the
 * first words of the step, so it goes to the recipe markup and not to the page.
 */
const steps = content.technique.map((step, i) => {
  const text = typeof step === 'string' ? step : step.text;
  return {
    name: typeof step === 'string' ? stepName(text) : step.name,
    named: typeof step !== 'string',
    text,
    anchor: `step-${i + 1}`,
  };
});

const pageUrl = new URL(`/pizza-styles/${content.slug}/`, Astro.site ?? 'https://thepizzadoughformula.com').href;

// Mixing, kneading and shaping before fermentation starts
const PREP_MINUTES = 30;
// Never claim a shorter bake than the page's stated range allows
const bakeRange = preset.bakeTime.match(/(\d+)\s*-\s*(\d+)/);
const statedBakeMinutes = preset.bakeTime.includes('second')
  ? Math.ceil(Number(bakeRange?.[2] ?? 90) / 60)
  : Number(bakeRange?.[2] ?? 12);
const cookMinutes = Math.min(preset.bakeTime.includes('second') ? 2 : 12, statedBakeMinutes);
// totalTime uses the low end of every fermentation range the page states, so it is never shorter
// than the schedule in the instructions.
const totalMinutes = PREP_MINUTES + content.minimumFermentationMinutes + cookMinutes;
const isoDuration = (minutes: number) => {
  const hours = Math.floor(minutes / 60);
  const rest = minutes % 60;
  return 'PT' + (hours > 0 ? hours + 'H' : '') + (rest > 0 ? rest + 'M' : '');
};

// Recipe schema for this style
const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": `${preset.name} Pizza Dough`,
  "description": content.intro,
  "recipeCategory": "Pizza Dough",
  "recipeCuisine": presetId === 'neapolitan' ? 'Italian' : presetId === 'newYork' ? 'American' : presetId === 'detroit' ? 'American' : 'International',
  "keywords": `${preset.name} pizza dough, ${preset.name} pizza recipe, pizza dough calculator`,
  "recipeYield": "4 dough balls",
  "prepTime": isoDuration(PREP_MINUTES),
  "cookTime": isoDuration(cookMinutes),
  "totalTime": isoDuration(totalMinutes),
  "image": [new URL('/images/hero-optimized.jpg', Astro.site ?? 'https://thepizzadoughformula.com').href],
  "recipeIngredient": recipeIngredients,
  "recipeInstructions": steps.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.name,
    "text": step.text,
    "url": `${pageUrl}#${step.anchor}`
  })),
  "nutrition": {
    "@type": "NutritionInformation",
    "servingSize": "1 dough ball",
    "calories": `${caloriesPerBall} calories`
  },
  "author": {
    "@type": "Person",
    "name": "Zack Pearson",
    "url": "https://thepizzadoughformula.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Pizza Dough Formula",
    "url": "https://thepizzadoughformula.com"
  }
};
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  type="article"
  schemaType="Article"
>
  <Header />

  <script type="application/ld+json" set:html={JSON.stringify(recipeSchema)} />

  <main class="flex-grow">
    <article class="max-w-3xl mx-auto px-4 py-12 md:py-16">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mb-8">
        <div class="flex items-center gap-4 mb-4">
          <div class="flex-shrink-0 w-14 h-14 flex items-center justify-center bg-primary/10 rounded-xl">
            <PizzaStyleIcon name={preset.icon} class="w-8 h-8 text-primary" />
          </div>
          <div>
            <h1 class="font-heading text-3xl md:text-4xl font-bold text-text">
              {preset.name} Pizza Dough
            </h1>
            <p class="text-text-muted">{preset.description}</p>
          </div>
        </div>
        <p class="text-sm text-text-muted">
          {lastUpdated && <>Last updated: {lastUpdated} · </>}6 min read
        </p>
      </header>

      {/* Key Specs Card */}
      <div class="bg-surface rounded-xl border border-border p-6 mb-8">
        <h2 class="font-heading text-lg font-semibold text-text mb-4">At a Glance</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
          <div>
            <dt class="text-text-muted">Hydration</dt>
            <dd class="font-mono font-semibold text-text">{Math.round(preset.defaults.hydration * 100)}%</dd>
          </div>
          <div>
            <dt class="text-text-muted">Ball Weight</dt>
            <dd class="font-mono font-semibold text-text">{preset.defaults.ballWeight}g</dd>
          </div>
          <div>
            <dt class="text-text-muted">Bake Temp</dt>
            <dd class="font-semibold text-text">{preset.bakeTemp}</dd>
          </div>
          <div>
            <dt class="text-text-muted">Bake Time</dt>
            <dd class="font-semibold text-text">{preset.bakeTime}</dd>
          </div>
          <div>
            <dt class="text-text-muted">Flour</dt>
            <dd class="font-semibold text-text">{preset.flourRecommendation}</dd>
          </div>
          <div>
            <dt class="text-text-muted">Equipment</dt>
            <dd class="font-semibold text-text">{preset.equipment}</dd>
          </div>
        </div>
        {caloriesPerBall > 0 && (
          <p class="mt-4 text-sm text-text-muted">
            Each {preset.defaults.ballWeight} g dough ball is roughly {caloriesPerBall} calories. That is an
            estimate worked out from the flour, oil and sugar in the recipe, using USDA FoodData Central figures.
          </p>
        )}
        <div class="mt-4 pt-4 border-t border-border">
          <a
            href={`/?s=${preset.id}`}
            class="inline-flex items-center gap-2 text-primary hover:text-primary-hover font-medium"
          >
            Open in Calculator
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      {/* Main Content */}
      <div class="prose prose-lg text-text-muted space-y-6">
        <p class="text-xl leading-relaxed">{content.intro}</p>

        {content.leadSections && <ContentSections sections={content.leadSections} />}

        <h2 class="font-heading text-2xl font-semibold text-text mt-10 mb-4">{content.historyTitle}</h2>
        <p>{content.history}</p>

        {content.doughScienceTitle && content.doughScience && (
          <>
            <h2 class="font-heading text-2xl font-semibold text-text mt-10 mb-4">{content.doughScienceTitle}</h2>
            <p>{content.doughScience}</p>
          </>
        )}

        {content.sections && <ContentSections sections={content.sections} />}

        <h2 class="font-heading text-2xl font-semibold text-text mt-10 mb-4">{content.techniqueTitle}</h2>
        <ol class="space-y-3 list-decimal list-outside pl-5">
          {steps.map(step => (
            <li id={step.anchor} class="text-text-muted scroll-mt-24">
              {step.named && <strong class="text-text font-semibold">{step.name}.</strong>}
              {step.named ? ' ' : ''}{step.text}
            </li>
          ))}
        </ol>

        {/* Pro Tips */}
        <div class="bg-olive/10 rounded-lg p-6 my-8">
          <h3 class="font-heading text-lg font-semibold text-text mb-3">Pro Tips</h3>
          <ul class="space-y-2 text-sm">
            {preset.tips.map(tip => (
              <li class="flex items-start gap-2">
                <span class="text-olive flex-shrink-0 mt-0.5">&#10003;</span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* Fermentation Guide */}
        <div class="bg-primary/10 border-l-4 border-primary rounded-r-lg p-4 my-8">
          <p class="font-semibold text-text mb-1">Fermentation Guide</p>
          <p class="text-text-muted text-sm">{preset.fermentInstructions}</p>
          <p class="text-text-muted text-sm mt-2">
            <strong>Water temperature:</strong> {preset.waterTemp}
          </p>
        </div>

        <h2 class="font-heading text-2xl font-semibold text-text mt-10 mb-4">Common Mistakes to Avoid</h2>
        <ul class="space-y-3">
          {content.commonMistakes.map(mistake => (
            <li class="flex items-start gap-2 text-text-muted">
              <span class="text-red-500 flex-shrink-0 mt-0.5">&#10007;</span>
              <span>{mistake}</span>
            </li>
          ))}
        </ul>

        {content.sources && (
          <>
            <h2 class="font-heading text-2xl font-semibold text-text mt-10 mb-4">Sources</h2>
            <ul class="space-y-2 text-sm list-disc list-outside pl-5">
              {content.sources.map(source => (
                <li class="text-text-muted">
                  <a href={source.url} target="_blank" rel="noopener" class="text-primary hover:text-primary-hover underline">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>

      {/* CTA */}
      <div class="mt-12 bg-surface rounded-xl border border-border p-6 text-center">
        <h2 class="font-heading text-xl font-semibold text-text mb-2">
          Ready to Make {preset.name} Pizza?
        </h2>
        <p class="text-text-muted mb-4">
          Get exact measurements for your {preset.name.toLowerCase()} dough with our free calculator.
        </p>
        <a
          href={`/?s=${preset.id}`}
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary-hover transition-colors"
        >
          Calculate {preset.name} Dough
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      {/* Related Styles */}
      <div class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-text mb-4">Related Pizza Styles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {content.relatedStyles.map(relId => {
            const rel = PIZZA_STYLES[relId];
            const relContent = Object.values(styleContent).find(s => slugToId[s.slug] === relId);
            if (!rel || !relContent) return null;
            return (
              <a
                href={`/pizza-styles/${relContent.slug}`}
                class="flex items-center gap-3 p-4 bg-surface rounded-lg border border-border hover:border-primary/50 transition-colors"
              >
                <PizzaStyleIcon name={rel.icon} class="w-8 h-8 text-primary flex-shrink-0" />
                <div>
                  <p class="font-medium text-text">{rel.name} Pizza</p>
                  <p class="text-sm text-text-muted">{rel.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      {/* Breadcrumb back */}
      <div class="mt-8 pt-6 border-t border-border">
        <a href="/pizza-styles" class="text-primary hover:text-primary-hover text-sm font-medium">
          &larr; View All Pizza Styles
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
