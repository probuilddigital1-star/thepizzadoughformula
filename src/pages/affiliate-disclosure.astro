---
/**
 * Affiliate Disclosure Page
 * FTC-compliant affiliate disclosure
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
---

<BaseLayout
  title="Affiliate Disclosure"
  description="Affiliate disclosure for The Pizza Dough Formula. Learn how we earn from affiliate links while keeping our recommendations honest."
>
  <Header />

  <main class="flex-grow">
    <article class="max-w-3xl mx-auto px-4 py-12 md:py-16">
      <h1 class="font-heading text-4xl font-bold text-text mb-6">
        Affiliate Disclosure
      </h1>

      <div class="prose prose-lg text-text-muted space-y-6">
        <p class="text-xl leading-relaxed">
          The Pizza Dough Formula is a participant in the Amazon Services LLC Associates Program.
          As an Amazon Associate I earn from qualifying purchases.
        </p>

        <h2 class="font-heading text-2xl font-semibold text-text mt-8 mb-4">What This Means</h2>
        <p>
          When we recommend products like pizza ovens, baking steels, scales, or ingredients,
          those links are affiliate links. If you click one and make a purchase, we may receive a
          small commission at no additional cost to you.
        </p>

        <h2 class="font-heading text-2xl font-semibold text-text mt-8 mb-4">How Products Are Chosen</h2>
        <p>
          Recommendations come from researching published specifications and matching them to the
          job on the page, such as a scale that reads to 0.1 g for small yeast amounts. They are not
          personal test results, and listing a product is not a claim that we own it.
        </p>
        <p>
          Commission rates play no part in what appears here, and we show no prices, because Amazon
          only permits prices pulled live from their API. You are never obligated to buy through our
          links.
        </p>

        <h2 class="font-heading text-2xl font-semibold text-text mt-8 mb-4">Affiliate Programs We Use</h2>
        <ul class="list-disc list-inside space-y-2">
          <li><strong>Amazon Associates</strong> - kitchen equipment, ingredients, and books</li>
        </ul>

        <h2 class="font-heading text-2xl font-semibold text-text mt-8 mb-4">How Affiliate Links Are Identified</h2>
        <p>
          Every block of product recommendations carries a disclosure directly above it, and the
          statement above appears in the footer of every page.
        </p>

        <h2 class="font-heading text-2xl font-semibold text-text mt-8 mb-4">Questions?</h2>
        <p>
          If you have any questions about our affiliate relationships or product recommendations,
          please don't hesitate to contact us.
        </p>

        <p class="text-sm text-text-muted/70 mt-8 pt-8 border-t border-border">
          This disclosure is made in accordance with the Federal Trade Commission's 16 CFR Part 255:
          "Guides Concerning the Use of Endorsements and Testimonials in Advertising."
        </p>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
