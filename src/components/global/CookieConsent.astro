---
/**
 * Analytics notice
 * Analytics (src/lib/analytics.ts) runs without cookies and without a consent choice, so this is a
 * one-time, dismissible notice rather than an accept/decline banner. The dismissal is kept in
 * localStorage so the notice shows once per browser.
 */
---

<div
  id="analyticsNotice"
  class="fixed bottom-0 left-0 right-0 z-50 p-4 bg-charcoal text-cream shadow-xl transform translate-y-full transition-transform duration-300"
  role="region"
  aria-label="Analytics notice"
>
  <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <p class="flex-1 text-cream/80 text-sm">
      This site uses cookie-free analytics that keep one identifier in your browser's local storage and may record how pages are used, with anything you type hidden.
      <a href="/privacy" class="underline hover:text-burnt-orange">Privacy policy</a>
    </p>
    <button
      id="analyticsNoticeDismiss"
      type="button"
      class="flex-shrink-0 px-4 py-2 text-sm font-medium bg-burnt-orange text-white rounded-lg hover:bg-burnt-orange-dark transition-colors"
    >
      Got it
    </button>
  </div>
</div>

<script>
  const NOTICE_KEY = 'analyticsNoticeDismissed';
  // Accept/decline choice saved by the former Google Analytics banner. Nothing reads it any more.
  const LEGACY_CONSENT_KEY = 'cookieConsent';

  const notice = document.getElementById('analyticsNotice');
  const dismissButton = document.getElementById('analyticsNoticeDismiss');

  function isDismissed(): boolean {
    try {
      return localStorage.getItem(NOTICE_KEY) === '1';
    } catch {
      return false;
    }
  }

  try {
    localStorage.removeItem(LEGACY_CONSENT_KEY);
  } catch {
    // Storage unavailable: nothing to clean up.
  }

  if (!isDismissed()) {
    setTimeout(() => notice?.classList.remove('translate-y-full'), 1000); // Slight delay for better UX
  }

  dismissButton?.addEventListener('click', () => {
    notice?.classList.add('translate-y-full');
    try {
      localStorage.setItem(NOTICE_KEY, '1');
    } catch {
      // Storage unavailable: the notice will show again on the next page.
    }
  });
</script>
