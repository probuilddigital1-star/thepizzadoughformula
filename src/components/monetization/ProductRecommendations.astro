---
/**
 * ProductRecommendations Component
 * Displays affiliate product recommendations, filtered by pizza style when provided.
 *
 * The Amazon tracking ID comes from the placement, not from the product data, so commissions can be
 * attributed to the page that earned them. The product data carries no tag of its own.
 * See docs/analytics-events.md for the placement and tracking ID tables.
 */
import affiliateData from '../../data/affiliateProducts.json';

interface Props {
  // Where this block sits: sets the Amazon tracking ID and the `placement` on affiliate events
  placement: string;
  style?: string;
  limit?: number;
  showTitle?: boolean;
  featured?: boolean;
}

/**
 * Pizza-only Amazon tracking IDs, introduced 2026-09-17. The double hyphen is part of each ID.
 * These are never used on another site. Adding a block anywhere means adding its placement here and
 * a row in docs/analytics-events.md.
 */
const TRACKING_IDS: Record<string, string> = {
  'style-guide': 'pizzaguide--20',
  'calculator-results': 'pizzacalc--20',
  'homepage-equipment': 'pizzahome--20'
};

const {
  placement,
  style = 'all',
  limit = 4,
  showTitle = true,
  featured = false
} = Astro.props;

const trackingId = TRACKING_IDS[placement];
if (!trackingId) {
  throw new Error(
    `ProductRecommendations: no Amazon tracking ID for placement "${placement}". ` +
    `Add it to TRACKING_IDS and docs/analytics-events.md. Known placements: ${Object.keys(TRACKING_IDS).join(', ')}.`
  );
}

// Filter products by style
let products = affiliateData.products.filter(product => {
  if (featured && !product.featured) return false;
  if (style === 'all') return true;
  return product.forStyles.includes(style) || product.forStyles.includes('all');
});

// Limit results
products = products.slice(0, limit);

/** The product link with this placement's tracking ID. */
function affiliateLink(url: string): string {
  const link = new URL(url);
  link.searchParams.set('tag', trackingId);
  return link.toString();
}

// No Product schema: without a price it is not eligible for product rich results, and Amazon
// Associates does not permit prices that are not pulled live from their API (ADR 0001, step 5).
---

{products.length > 0 && (
  <div class="product-recommendations" data-placement={placement} data-style={style === 'all' ? 'none' : style}>
    {showTitle && (
      <div class="mb-4">
        <h3 class="font-heading text-lg font-semibold text-text">
          Recommended Equipment
        </h3>
        <p class="text-sm text-text-muted">
          Chosen from published specifications for the job described on this page
        </p>
      </div>
    )}

    {/* Affiliate disclosure, directly above the recommendations */}
    <p class="text-xs text-text-muted mb-3">
      {affiliateData._meta.affiliateDisclaimer}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {products.map((product) => (
        <a
          href={affiliateLink(product.affiliateUrl)}
          target="_blank"
          rel="noopener sponsored"
          class="product-card group flex items-start gap-4 p-4 bg-surface border border-border rounded-lg transition-all hover:border-primary hover:shadow-md"
          data-product-id={product.id}
        >
          <div class="flex-1 min-w-0">
            <h4 class="font-semibold text-text group-hover:text-primary transition-colors">
              {product.name}
            </h4>
            <p class="text-sm text-text-muted mt-1">
              {product.description}
            </p>
          </div>
          <div class="flex-shrink-0 self-center text-right">
            <p class="text-xs text-text-muted">
              View on Amazon →
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
)}

<script>
  import { track } from '../../lib/analytics';

  // Amazon tracking ID from a link's `tag` parameter, or 'none' when the link has none
  function trackingIdFromUrl(href: string): string {
    try {
      return new URL(href).searchParams.get('tag') || 'none';
    } catch {
      return 'none';
    }
  }

  document.querySelectorAll<HTMLElement>('.product-recommendations[data-placement]').forEach((block) => {
    const placement = block.dataset.placement;
    const style = block.dataset.style;
    const links = Array.from(block.querySelectorAll<HTMLAnchorElement>('a[data-product-id]'));

    // affiliate_exposure: once per block per page view, when any part of the block enters the viewport
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        track('affiliate_exposure', {
          placement,
          style,
          product_ids: links.map((link) => link.dataset.productId ?? ''),
        });
      });
      observer.observe(block);
    }

    // affiliate_click: left clicks, plus middle clicks that open the link in a new tab
    function handleLinkClick(event: MouseEvent) {
      if (event.type === 'auxclick' && event.button !== 1) return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-product-id]') : null;
      if (!link) return;
      track('affiliate_click', {
        placement,
        style,
        product_id: link.dataset.productId,
        tracking_id: trackingIdFromUrl(link.href),
      });
    }
    block.addEventListener('click', handleLinkClick);
    block.addEventListener('auxclick', handleLinkClick);
  });
</script>
